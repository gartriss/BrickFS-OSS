# Mi-Sans hype
ro.miui.ui.fonttype=mipro
ro.miui.ui.font.theme_apply=true
ro.miui.ui.font.animation=disable
ro.miui.ui.font.version=2
ro.miui.ui.font.mi_font_path=/system/fonts/MiSansVF.ttf

# Spoof Bootloader
ro.boot.verifiedbootstate=green
vendor.boot.verifiedbootstate=green
vendor.boot.vbmeta.device_state=locked
ro.boot.veritymode=enforcing
ro.boot.vbmeta.device_state=locked
ro.boot.flash.locked=1

# Google Fingerprint
ro.build.fingerprint=google/akita_beta/akita:Baklava/BP22.250103.008/12932282:user/release-keys


